# ==============================================================================
# Variables de Entorno Oficiales — BuyaCAR Omnicanal en Railway / Cloud
# ==============================================================================
# Pega estas variables en la pestaña "Variables" de tu servicio en Railway.

# --- 1. MODO OPERATIVO Y SEGURIDAD ---
# Opciones: SIMULATION (pruebas seguras sin envíos externos), DRAFT (borradores para aprobación), o AUTOPILOT (envíos 100% automáticos)
BUYACAR_OPERATING_MODE=AUTOPILOT

# --- 2. INTELIGENCIA ARTIFICIAL (GOOGLE GEMINI 2.5 FLASH) ---
# Clave obtenida gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo a utilizar por defecto (recomendado por velocidad y bajo costo)
GEMINI_MODEL=gemini-2.5-flash

# --- 3. ESTRATEGIA DE ECONOMÍA DE TOKENS (KAIZEN) ---
# Opciones:
# A4_adaptive (RECOMENDADA): Fast-Path local para preguntas simples (0 tokens, <1ms) + RAG local + Gemini solo para asesoría abierta/comparativas.
# A2_rag_synth: Modo ultra-ahorro 100% local determinista (0 tokens en todo momento).
BUYACAR_STRATEGY=A4_adaptive

# --- 4. CATÁLOGO VEHICULAR EN VIVO (WORDPRESS VEHICA) ---
# Sincroniza en tiempo real con el inventario de Tunja en buyacar.com.co (1 = activado)
BUYACAR_LIVE_INVENTORY_SYNC=1

# --- 5. LÍNEAS OFICIALES Y DATOS DE LA SEDE (TUNJA, BOYACÁ) ---
BUYACAR_SEDE_DIRECCION=Av. Oriental - Cra. 6 # 52-23, frente a la Toyota, Tunja
BUYACAR_WHATSAPP_VENTAS=3151212223
BUYACAR_TEL_LINEA2=3022866969
BUYACAR_TEL_LINEA3=3160502717

# --- 6. INTEGRACIÓN CON N8N Y CANALES EXTERNOS ---
# URL interna o pública de tu instancia n8n en Railway
N8N_BASE_URL=https://n8n-production-ae55.up.railway.app

# --- 7. META DEVELOPERS / FACEBOOK MARKETPLACE (OPCIONAL SI USAS N8N COMO PUENTE) ---
META_PAGE_ID=buyacar-page-prod
META_VERIFY_TOKEN=buyacar-verify-prod-2026
META_APP_SECRET=
META_ACCESS_TOKEN=
