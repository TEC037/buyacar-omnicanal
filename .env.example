# Plantilla de Variables de Entorno para Railway (y entorno local)
# En Railway, pega estas variables en la pestaña "Variables" de tu servicio.

# Puerto que asigna Railway automáticamente (no modificar si Railway lo provee)
PORT=8080

# Modo de operación inicial: SIMULATION, DRAFT o AUTOPILOT
BUYACAR_OPERATING_MODE=SIMULATION

# Clave de Google AI Studio para activar Gemini 2.5 Flash
# Obténla gratis en: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sincronización en vivo con el catálogo WordPress de BuyaCAR (1 = activa)
BUYACAR_LIVE_INVENTORY_SYNC=1

# Configuración de Meta Webhook (Opcional si usas n8n como receptor)
META_PAGE_ID=buyacar-page-prod
META_VERIFY_TOKEN=buyacar-verify-prod-2026
META_APP_SECRET=
META_ACCESS_TOKEN=
