    {
      "parameters": {
        "jsCode": "// ============================================================================\n// NORMALIZADOR OMNICANAL MULTICANAL — BuyaCAR Tunja\n// Extrae el mensaje, remitente y anuncio sin importar por cuál canal ingresó.\n// ============================================================================\nconst item = $input.first().json;\nconst body = item.body || item;\n\nlet channel = 'general';\nlet senderId = 'cliente-desconocido';\nlet message = '';\nlet adTitle = '';\n\n// 1. Detección si proviene de WhatsApp (Evolution API, Z-API o Cloud API)\nif (body.data?.message || body.messages || body.entry?.[0]?.changes?.[0]?.value?.messages) {\n  channel = 'whatsapp';\n  const waMsg = body.data?.message || body.messages?.[0] || body.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\n  senderId = body.data?.key?.remoteJid || waMsg?.from || body.phone || 'whatsapp-user';\n  message = waMsg?.conversation || waMsg?.extendedTextMessage?.text || waMsg?.text?.body || '';\n} \n// 2. Detección si proviene de Meta (Facebook Marketplace / Messenger)\nelse if (body.entry?.[0]?.messaging) {\n  const m = body.entry[0].messaging[0];\n  channel = body.object === 'instagram' ? 'instagram' : 'facebook_marketplace';\n  senderId = m.sender?.id || 'meta-user';\n  message = m.message?.text || '';\n  adTitle = m.message?.referral?.ad_title || m.referral?.ad_title || '';\n}\n// 3. Detección si proviene del Chat Web embebido en buyacar.com.co\nelse if (item.chatInput || body.chatInput) {\n  channel = 'web_chat';\n  senderId = item.sessionId || 'visitante-web';\n  message = item.chatInput || body.chatInput || '';\n}\n// 4. Formato genérico REST / CRM\nelse {\n  channel = body.channel_id || 'api_rest';\n  senderId = body.customer_alias || body.sender_id || 'lead-omnicanal';\n  message = body.message || body.text || '¿Sigue disponible?';\n  adTitle = body.ad_title || '';\n}\n\nreturn [{\n  json: {\n    channel_id: channel,\n    customer_alias: senderId,\n    ad_title: adTitle,\n    message: String(message).trim()\n  }\n}];"
      },
