        "options": {
          "timeout": 8000
        }
      },
      "id": "bridge-http-buyacar",
      "name": "2. Cerebro BuyaCAR Go (POST /api/n8n/webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      },
      "id": "bridge-respond",
