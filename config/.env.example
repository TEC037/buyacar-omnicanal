# ==============================================================================
# BuyaCAR Omnicanal — Archivo de Configuración de Entorno (.env.example)
# Copia este archivo a '.env' o define estas variables en tu entorno (Railway)
# ==============================================================================

# Modo Operativo Maestro: SIMULATION (pruebas), DRAFT (supervisión 1-clic), AUTOPILOT (envío autónomo)
BUYACAR_OPERATING_MODE=DRAFT

# Sincronización en vivo con el catálogo oficial de buyacar.com.co
BUYACAR_LIVE_INVENTORY_SYNC=1

# Puerto del servidor embebido de supervisión
PORT=8080

# Contraseña de acceso seguro al panel CRM de BuyaCAR en Tunja
BUYACAR_ADMIN_PASSWORD=buyacar2026

# Meta for Developers — Facebook Marketplace & Messenger (100% nativo)
META_PAGE_ID=1029384756
META_ACCESS_TOKEN=EAAB...
META_APP_SECRET=tu_meta_app_secret_hmac
META_VERIFY_TOKEN=buyacar-verify-sim

# Meta WhatsApp Cloud API Oficial (100% nativo)
WHATSAPP_PHONE_NUMBER_ID=1092837465
WHATSAPP_CLOUD_TOKEN=EAAB...
WHATSAPP_VERIFY_TOKEN=buyacar-verify-sim
WHATSAPP_APP_SECRET=tu_meta_app_secret_hmac

# Google AI Studio — Gemini 2.5 Flash (Opcional, Fast-Path responde con 0 tokens)
# GEMINI_API_KEY=AIzaSy...

# Servidor Local Ollama (Respaldo opcional en 127.0.0.1)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
