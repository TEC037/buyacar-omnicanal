# ==============================================================================
# BuyaCAR Omnicanal — Archivo de Configuración de Entorno (.env.example)
# Copia este archivo a '.env' o define estas variables en tu entorno
# ==============================================================================

# Modo Operativo Maestro: SIMULATION (por defecto), DRAFT (piloto), AUTOPILOT
BUYACAR_OPERATING_MODE=SIMULATION

# Puerto del servidor embebido de supervisión
PORT=8080

# Servidor Local Ollama (Inferencia y Embeddings densos RAG)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Meta WhatsApp Cloud API Oficial (Canal Piloto / Producción)
# WHATSAPP_CLOUD_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=1092837465...
# WHATSAPP_VERIFY_TOKEN=buyacar_webhook_secret_verify

# MercadoLibre Webhooks
# MERCADOLIBRE_CLIENT_SECRET=tu_secreto_mercadolibre_hmac

# Invalidación de Inventario DMS / Concesionario Local
# ERP_WEBHOOK_SECRET=tu_secreto_invalidation_hmac

# Exportación Externa a CRM (HubSpot / Salesforce / CRM Local)
# CRM_WEBHOOK_URL=https://crm.buyacar.com.co/api/leads/webhook
# CRM_HMAC_SECRET=tu_secreto_crm_export_hmac
